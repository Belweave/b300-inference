# Model-specific preview; resolve and record the digest on each rental.
ENGINE_IMAGE=${ENGINE_IMAGE:-lmsysorg/sglang:dev-dsv41}
# 128 staged for Nov 1; bootstrap falls back to 64 if the KV-pool fit check fails.
MAX_RUNNING_REQUESTS=${MAX_RUNNING_REQUESTS:-128}
CHUNKED_PREFILL_SIZE=${CHUNKED_PREFILL_SIZE:-8192}
CUDA_GRAPH_MAX_BS=${CUDA_GRAPH_MAX_BS:-128}
MEM_FRACTION=${MEM_FRACTION:-0.85}
CONTEXT_LENGTH=${CONTEXT_LENGTH:-262144}
# Starting knobs; measure the actual KV pool before tuning concurrency/memory.
# Baseline TP8/EP8; DP-attention is an opt-in comparison.
PARALLELISM=${PARALLELISM:-tp}
SPECULATION=${SPECULATION:-none}
